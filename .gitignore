# Contributor PII — real emails for factory minting (see .example)
/priv/repo/factory_contributors.exs

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
replicant_server-*.tar

# Node.js dependencies (installed at build time)
/assets/node_modules/

# Compiled assets (built via "mix assets.deploy" during Docker build)
/priv/static/assets/
/priv/static/cache_manifest.json

# Kamal secrets and config (contains passwords/server details)
.kamal/secrets
config/deploy.yml

# Claude Code local session/handoff state (never commit)
.claude/session-state.md
.claude/handoff-consent
.claude/handoff-*
.claude/context.md
.claude/current-task.md
.claude/current-bug.md
.claude/bug-test-log.md
.claude/task-history.md
.claude/recent-prompts.md
.claude/mode
.claude/worktrees/
